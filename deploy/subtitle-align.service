[Unit]
Description=Subtitle Alignment Service
After=network.target

[Service]
Type=simple
User=subtitle
Group=subtitle
WorkingDirectory=/opt/subtitle-align
ExecStart=/usr/bin/python3 /opt/subtitle-align/start_server.py
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
