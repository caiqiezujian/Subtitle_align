# 数据与 GPU
SUBALIGN_DATA_DIR=./data
SUBALIGN_MAX_UPLOAD_MB=4096
SUBALIGN_MAX_CONCURRENT_JOBS=1
SUBALIGN_API_KEY=
SUBALIGN_ALLOW_ORIGINS=
CUDA_VISIBLE_DEVICES=0
QWEN_MODEL_ROOT=/data/yb/Code/models

# 公司内部 OpenAI-compatible v4-flash（与 tranx-mtqe 保持一致）
V4_FLASH_ENABLED=false
V4_FLASH_BASE_URL=http://10.185.1.71:8080/v1
V4_FLASH_API_KEY=
V4_FLASH_MODEL=dsv4
V4_FLASH_TIMEOUT_SECONDS=120
V4_FLASH_RETRY_COUNT=2
# 内部 HTTPS 使用自签证书时保持 false
V4_FLASH_VERIFY_SSL=false
